use Std::*;
use Base64::*;
use Common::*;

fn main()
    where
        PostRing[bitwise[8]],
        PostRing[bitwise[64]],
        Vectorization
{
    let dummy : int[bitwise[64]] $post @prover = wire { 0 };

    let msg_pre : list[u8 $pre @prover] $pre @prover = get_witness("msg");
    dbg_print(to_string(length(msg_pre)));
    let msg : list[int[bitwise[8]] $post @prover] = for i in 0 .. 33 * 45 { wire { msg_pre[i as @prover] as int[bitwise[8]] } };
    let out = base64(msg);
    print_as_string(for i in 0 .. length(out) { out[i] as $pre as u8 });

    let expected_base64_pre : list[u8 $pre @prover] $pre @prover = get_witness("expected_base64");
    dbg_print(to_string(length(expected_base64_pre)));
    let expected_base64 : list[int[bitwise[8]] $post @prover] = for i in 0 .. 44 * 45 { wire { expected_base64_pre[i as @prover] as int[bitwise[8]] } };

    dbg_assert(length(out) == length(expected_base64));
    for i in 0 .. length(out) {
        assert_zero(out[i] - expected_base64[i]);
    }
    {}
}
