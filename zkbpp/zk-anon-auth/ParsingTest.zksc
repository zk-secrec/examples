// ./runrust zkbpp/zk-anon-auth/ParsingTest.zksc -e zkbpp/zk-anon-auth/zk-anon-auth.rs -c zkbpp/zkbpp.ccc --zkbpp -o zkbpp/generated
// ./runrust zkbpp/zk-anon-auth/ParsingTest.zksc -e zkbpp/zk-anon-auth/zk-anon-auth.rs -c zkbpp/zkbpp.ccc --zkbpp -o zkbpp/generated-verifier --verifier

use Std::*;
use Parsing::*;
use Common::*;

fn main()
    where
        PostRing[bitwise[8]],
        PostRing[bitwise[64]],
        PostConvertible[bitwise[8],bitwise[64]],
        PostConvertible[bitwise[64],bitwise[8]],
        Vectorization
{
    let x_public : list[u8 $pre @public] = string_to_list("{\"sub\":\"1234567890\",\n\"iss\":\"google.com\",\n\"aud\":\"36364236\",\n\"stid\":\"78264\\\\\\\"5\\\"697\\\\\",\n\"iat\":12424535,\n\"exp\":12425535,\n\"nonce\":\"rhdg4se3erfs\"}");
    let x_pre : list[u8 $pre @prover] = for i in 0 .. length(x_public) { x_public[i] as @prover };
    print_as_string(x_pre);
    let max_xlen : u64 $pre @public = 1500;
    dbg_assert(length(x_pre) <= max_xlen);
    let x_pre = append(x_pre, [0; max_xlen - length(x_pre)]); // Add zeros to make the length equal to the public upper bound
    let x : list[int[bitwise[8]] $post @prover] =
        for i in 0 .. length(x_pre) {
            wire { x_pre[i] as int[bitwise[8]] }
        };
    let x_padded = append(x, [0; 20]); // Add as many zeros as the maximum length of the longest extracted field
    let x_padded = freeze(x_padded);
    let json_stid = extract_json_field("stid", x_padded, 20);
    print_as_string(for i in 0 .. length(json_stid) { json_stid[i] as $pre as u8 });
    let json_aud = extract_json_field("aud", x_padded, 8);
    print_as_string(for i in 0 .. length(json_aud) { json_aud[i] as $pre as u8 });
    let json_iss = extract_json_field("iss", x_padded, 12);
    print_as_string(for i in 0 .. length(json_iss) { json_iss[i] as $pre as u8 });
    let json_nonce = extract_json_field("nonce", x_padded, 13);
    print_as_string(for i in 0 .. length(json_nonce) { json_nonce[i] as $pre as u8 });
    {}
}
